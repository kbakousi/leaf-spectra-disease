    journal: Sensors
    year: 2018
    doi: 10.3390/s18020441
  - type: article
    authors: [{family-names: Mahlein, given-names: Anne-Katrin}]
    title: "Plant Disease Detection by Imaging Sensors - Parallels and Specific Demands for Precision Agriculture and Plant Phenotyping"
    journal: Plant Disease
    year: 2016
    doi: 10.1094/PDIS-03-15-0340-FE
  - type: article
    authors: [{family-names: Roberts, given-names: David R.}]
    title: "Cross-validation strategies for data with temporal, spatial, hierarchical, or phylogenetic structure"
    journal: Ecography
    year: 2017
    doi: 10.1111/ecog.02881
  - type: article
    authors: [{family-names: Barker, given-names: Matthew}]
